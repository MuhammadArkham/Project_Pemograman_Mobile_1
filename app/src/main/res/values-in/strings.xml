    <string name="offline_tip_underweight"><![CDATA[<b>Berat badan Anda di bawah ideal.</b><br/><br/>&#8226; Rentang berat ideal untuk tinggi Anda adalah <b>%1$.1f - %2$.1f kg</b>.<br/>&#8226; <b>Tingkatkan asupan kalori</b> bertahap (300–500 kkal/hari).<br/>&#8226; <b>Perbanyak protein</b> — telur, ayam, ikan, susu.<br/>&#8226; <b>Makan 5–6 kali sehari</b>.<br/>&#8226; <b>Latihan kekuatan</b> 2–3× seminggu.]]></string>
    <string name="offline_tip_normal"><![CDATA[<b>Selamat! BMI Anda ideal.</b><br/><br/>&#8226; Rentang berat ideal untuk tinggi Anda adalah <b>%1$.1f - %2$.1f kg</b>.<br/>&#8226; <b>Pola makan seimbang</b> — 50%% sayur/buah, 25%% karbo, 25%% protein.<br/>&#8226; <b>Aktif bergerak</b> 150 menit/minggu.<br/>&#8226; <b>Jaga hidrasi</b> (8 gelas/hari).<br/>&#8226; <b>Tidur cukup</b> 7–9 jam.]]></string>
    <string name="offline_tip_overweight"><![CDATA[<b>BMI Anda kategori gemuk.</b><br/><br/>&#8226; Rentang berat ideal untuk tinggi Anda adalah <b>%1$.1f - %2$.1f kg</b>.<br/>&#8226; <b>Defisit kalori</b> (kurangi 300–500 kkal/hari).<br/>&#8226; <b>Kurangi karbo olahan</b>.<br/>&#8226; <b>Kardio</b> 30 menit/hari.<br/>&#8226; <b>Perbanyak serat</b> agar kenyang lebih lama.]]></string>
    <string name="offline_tip_obese"><![CDATA[<b>BMI obesitas — butuh tindakan serius.</b><br/><br/>&#8226; Rentang berat ideal untuk tinggi Anda adalah <b>%1$.1f - %2$.1f kg</b>.<br/>&#8226; <b>Konsultasi dokter</b> terkait risiko penyakit.<br/>&#8226; <b>Jalan kaki</b> 20–30 menit/hari.<br/>&#8226; <b>Kurangi gula & gorengan</b> secara bertahap.]]></string>

