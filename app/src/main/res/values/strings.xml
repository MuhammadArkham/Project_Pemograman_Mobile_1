    <string name="offline_tip_underweight"><![CDATA[<b>Your weight is below ideal.</b><br/><br/>&#8226; Ideal weight range for your height is <b>%1$.1f - %2$.1f kg</b>.<br/>&#8226; <b>Increase calorie intake</b> gradually (300–500 kcal/day).<br/>&#8226; <b>Eat more protein</b> — eggs, chicken, fish, milk.<br/>&#8226; <b>Eat 5–6 times a day</b>.<br/>&#8226; <b>Strength training</b> 2–3× a week.]]></string>
    <string name="offline_tip_normal"><![CDATA[<b>Congratulations! Your BMI is ideal.</b><br/><br/>&#8226; Ideal weight range for your height is <b>%1$.1f - %2$.1f kg</b>.<br/>&#8226; <b>Balanced diet</b> — 50%% veg/fruits, 25%% carbs, 25%% protein.<br/>&#8226; <b>Stay active</b> 150 mins/week.<br/>&#8226; <b>Stay hydrated</b> (8 glasses/day).<br/>&#8226; <b>Enough sleep</b> 7–9 hours.]]></string>
    <string name="offline_tip_overweight"><![CDATA[<b>Your BMI indicates overweight.</b><br/><br/>&#8226; Ideal weight range for your height is <b>%1$.1f - %2$.1f kg</b>.<br/>&#8226; <b>Calorie deficit</b> (reduce 300–500 kcal/day).<br/>&#8226; <b>Reduce refined carbs</b>.<br/>&#8226; <b>Cardio</b> 30 mins/day.<br/>&#8226; <b>More fiber</b> to stay full longer.]]></string>
    <string name="offline_tip_obese"><![CDATA[<b>Obese BMI — serious action needed.</b><br/><br/>&#8226; Ideal weight range for your height is <b>%1$.1f - %2$.1f kg</b>.<br/>&#8226; <b>Consult a doctor</b> regarding health risks.<br/>&#8226; <b>Walk</b> 20–30 mins/day.<br/>&#8226; <b>Reduce sugar & fried foods</b> gradually.]]></string>

