    <string name="offline_tip_underweight"><![CDATA[<b>Tu peso está por debajo del ideal.</b><br/><br/>&#8226; El rango ideal para tu altura es <b>%1$.1f - %2$.1f kg</b>.<br/>&#8226; <b>Aumenta las calorías</b> gradualmente (300–500 kcal/día).<br/>&#8226; <b>Más proteínas</b> — huevos, pollo, pescado, leche.<br/>&#8226; <b>Come 5–6 veces al día</b>.<br/>&#8226; <b>Entrenamiento de fuerza</b> 2–3× por semana.]]></string>
    <string name="offline_tip_normal"><![CDATA[<b>¡Felicidades! Tu IMC es ideal.</b><br/><br/>&#8226; El rango ideal para tu altura es <b>%1$.1f - %2$.1f kg</b>.<br/>&#8226; <b>Dieta equilibrada</b> — 50%% verdura/fruta, 25%% carbos, 25%% proteína.<br/>&#8226; <b>Mantente activo</b> 150 min/semana.<br/>&#8226; <b>Buena hidratación</b> (8 vasos/día).<br/>&#8226; <b>Duerme</b> 7–9 horas.]]></string>
    <string name="offline_tip_overweight"><![CDATA[<b>Tu IMC indica sobrepeso.</b><br/><br/>&#8226; El rango ideal para tu altura es <b>%1$.1f - %2$.1f kg</b>.<br/>&#8226; <b>Déficit calórico</b> (reduce 300–500 kcal/día).<br/>&#8226; <b>Reduce carbos refinados</b>.<br/>&#8226; <b>Cardio</b> 30 min/día.<br/>&#8226; <b>Más fibra</b> para mayor saciedad.]]></string>
    <string name="offline_tip_obese"><![CDATA[<b>Obesidad — requiere atención seria.</b><br/><br/>&#8226; El rango ideal para tu altura es <b>%1$.1f - %2$.1f kg</b>.<br/>&#8226; <b>Consulta a un médico</b> sobre los riesgos.<br/>&#8226; <b>Camina</b> 20–30 min/día.<br/>&#8226; <b>Reduce azúcar y fritos</b> gradualmente.]]></string>

