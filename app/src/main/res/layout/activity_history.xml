<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg">

    <!-- Background Image / Gradient Header -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@drawable/bg_splash_gradient"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="@id/header"
        app:layout_constraintBottom_toBottomOf="@id/header"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="56dp"
        android:paddingBottom="54dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHistoryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_history"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:includeFontPadding="false"
                    android:fontFamily="@font/poppins_bold"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutHeaderBmiCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_translucent"
            android:orientation="vertical"
            android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp">

                <TextView
                    android:id="@+id/tvBmiCurrentLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="@string/bmi_current_label"
                    android:textColor="@color/header_text_high_contrast"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/tvHeaderBmiMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    tools:text="14 Okt 2025 • 65 kg"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#C3E6DB"
                    android:textSize="10sp"
                    android:visibility="gone"/>
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvHeaderBmiValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="19.5"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="40sp"
                    android:includeFontPadding="false"/>

                <TextView
                    android:id="@+id/tvHeaderBmiRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="11sp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_header_range_badge"
                    android:textColor="@color/white"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="6dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="8dp"
                app:cardCornerRadius="4dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                android:layout_marginBottom="10dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:weightSum="40">
                    <View android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="10.0" android:background="@color/bmi_underweight"/>
                    <View android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="10.0" android:background="@color/bmi_normal"/>
                    <View android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="10.0" android:background="@color/bmi_overweight"/>
                    <View android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="10.0" android:background="@color/bmi_obese"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kurus" android:fontFamily="@font/poppins_bold" android:textSize="9sp" android:textColor="@color/bmi_underweight"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&lt; 18.5" android:fontFamily="@font/poppins_regular" android:textSize="9sp" android:textColor="@color/white" android:layout_marginTop="-2dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Normal" android:fontFamily="@font/poppins_bold" android:textSize="9sp" android:textColor="@color/bmi_normal"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18.5-25" android:fontFamily="@font/poppins_regular" android:textSize="9sp" android:textColor="@color/white" android:layout_marginTop="-2dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Gemuk" android:fontFamily="@font/poppins_bold" android:textSize="9sp" android:textColor="@color/bmi_overweight"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25-30" android:fontFamily="@font/poppins_regular" android:textSize="9sp" android:textColor="@color/white" android:layout_marginTop="-2dp"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Obesitas" android:fontFamily="@font/poppins_bold" android:textSize="9sp" android:textColor="@color/bmi_obese"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&gt; 30" android:fontFamily="@font/poppins_regular" android:textSize="9sp" android:textColor="@color/white" android:layout_marginTop="-2dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:fillViewport="true"
        android:layout_marginTop="-24dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_content_round_top"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp">

            <!-- KARTU GRAFIK -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/fitme_border"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tvTrendTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/trend_title"
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="15sp"
                            android:textColor="@color/fitme_dark_green"/>

                        <!-- Tombol Periode (Dikembalikan ke desain asli) -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/btnPeriod3"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:text="@string/period_3mo"
                                android:fontFamily="@font/poppins_bold"
                                android:textSize="11sp"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:background="@drawable/bg_period_btn_active"
                                android:textColor="@color/white"
                                android:layout_marginStart="4dp"/>

                            <TextView
                                android:id="@+id/btnPeriod6"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:text="@string/period_6mo"
                                android:fontFamily="@font/poppins_bold"
                                android:textSize="11sp"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:background="@drawable/bg_period_btn"
                                android:textColor="@color/nav_inactive"
                                android:layout_marginStart="4dp"/>

                            <TextView
                                android:id="@+id/btnPeriodAll"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:text="@string/period_all"
                                android:fontFamily="@font/poppins_bold"
                                android:textSize="11sp"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:background="@drawable/bg_period_btn"
                                android:textColor="@color/nav_inactive"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/lineChart"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- LABEL RIWAYAT PENGUKURAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvSectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/section_measurement"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="15sp"
                    android:textColor="@color/fitme_dark_green"/>

                <TextView
                    android:id="@+id/tvCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="0 catatan"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="12sp"
                    android:textColor="@color/fitme_text_secondary"/>
            </LinearLayout>

            <!-- EMPTY STATE (Diperbaiki: Ikon History Bulat) -->
            <LinearLayout
                android:id="@+id/layoutEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="50dp"
                android:paddingBottom="24dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:gravity="center"
                    android:background="@drawable/bg_circle_translucent"
                    android:backgroundTint="#F0F4F2"
                    android:layout_marginBottom="16dp">
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_history"
                        app:tint="#A0B8B0"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/history_empty"
                    android:textColor="@color/fitme_dark_green"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvEmptySubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_history_subtitle"
                    android:textColor="@color/fitme_text_secondary"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- DAFTAR ITEM HISTORY -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewHistory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:overScrollMode="never"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ══════════════════════════════════════════════════════════════
         BOTTOM NAVIGATION
         ══════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/layoutBottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.fitme.app.ui.home.CurvedBottomBarBg
            android:id="@+id/curvedBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"/>

        <LinearLayout
            android:id="@+id/navBar"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:weightSum="3"
            android:elevation="0dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout android:id="@+id/btnNavHome"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:orientation="vertical"
                android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView android:id="@+id/icNavHome"
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_home" app:tint="@color/nav_inactive"/>
                <TextView android:id="@+id/tvNavHome"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/nav_home" android:textSize="10sp" android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/nav_inactive" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnNavMakan"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:orientation="vertical"
                android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView android:id="@+id/icNavMakan"
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_restaurant" app:tint="@color/nav_inactive"/>
                <TextView android:id="@+id/tvNavMakan"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/nav_food" android:textSize="10sp" android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/nav_inactive" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnNavHistory"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:gravity="center" android:orientation="vertical"
                android:clickable="true" android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView android:id="@+id/icNavHistory"
                    android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_history" app:tint="#00000000"/>
                <TextView android:id="@+id/tvNavHistory"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/nav_history" android:textSize="10sp" android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/fitme_green" android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/navIndicator"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="top|start"
            app:cardBackgroundColor="@color/fitme_green"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp">
            <ImageView android:id="@+id/icNavFloating"
                android:layout_width="22dp" android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_history" app:tint="@color/white"/>
        </androidx.cardview.widget.CardView>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>