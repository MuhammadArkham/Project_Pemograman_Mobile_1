<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:padding="32dp">

    <LinearLayout
        android:id="@+id/layout_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:text="F"
            android:textColor="@color/fitme_green"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="1dp"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:text="ITME"
            android:textColor="@color/fitme_dark_green"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@+id/layout_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/layout_logo">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:letterSpacing="0.05"
            android:text="@string/share_health_report"
            android:textAllCaps="true"
            android:textColor="#9E9E9E"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/shareDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:textColor="#6B9B8E"
                android:textSize="13sp"
                tools:text="11 Mei" />

            <TextView
                android:id="@+id/shareYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/poppins_bold"
                android:textColor="#6B9B8E"
                android:textSize="13sp"
                tools:text="2026" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/shareBmiLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:fontFamily="@font/poppins_bold"
        android:letterSpacing="0.1"
        android:text="@string/share_bmi_label"
        android:textColor="#9E9E9E"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_logo" />

    <TextView
        android:id="@+id/shareBmiValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_bold"
        android:includeFontPadding="false"
        android:textColor="@color/fitme_dark_green"
        android:textSize="100sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shareBmiLabel"
        tools:text="25.8" />

    <TextView
        android:id="@+id/shareBmiStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_share_status_solid"
        android:fontFamily="@font/poppins_bold"
        android:letterSpacing="0.05"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shareBmiValue"
        tools:text="GEMUK" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_bmi_scale"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="48dp"
        app:cardCornerRadius="6dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/shareBmiStatus">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:weightSum="4">
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.30" android:background="@color/bmi_underweight" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.90" android:background="@color/bmi_normal" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.80" android:background="@color/bmi_overweight" />
            <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.00" android:background="@color/bmi_obese" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/layout_scale_labels"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cv_bmi_scale">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.30" android:fontFamily="@font/poppins_bold" android:gravity="start" android:maxLines="1" android:text="@string/bmi_underweight" android:textColor="@color/bmi_underweight" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.90" android:fontFamily="@font/poppins_bold" android:gravity="center" android:maxLines="1" android:text="@string/bmi_normal" android:textColor="@color/bmi_normal" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.80" android:fontFamily="@font/poppins_bold" android:gravity="center" android:maxLines="1" android:text="@string/bmi_overweight" android:textColor="@color/bmi_overweight" android:textSize="10sp" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.00" android:fontFamily="@font/poppins_bold" android:gravity="end" android:maxLines="1" android:text="@string/bmi_obese" android:textColor="@color/bmi_obese" android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_scale_labels">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_detail_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/share_age_label"
                android:textColor="#6B9B8E"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/shareAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:textColor="@color/fitme_text_primary"
                android:textSize="22sp"
                tools:text="25" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_detail_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/share_gender_label"
                android:textColor="#6B9B8E"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/shareGender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:textColor="@color/fitme_text_primary"
                android:textSize="22sp"
                tools:text="Pria" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:letterSpacing="0.05"
        android:text="@string/share_footer"
        android:textColor="#BDBDBD"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layout_stats" />

</androidx.constraintlayout.widget.ConstraintLayout>