<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient"
    android:fitsSystemWindows="true">

    <!-- DARK GREEN HEADER AREA -->
    <LinearLayout
        android:id="@+id/layout_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Baris: Back + Judul -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/btn_back_articles"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_glass_circle"
                android:contentDescription="Kembali"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/poppins_bold"
                android:text="Info Kesehatan"
                android:textColor="@color/white"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Search Bar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#999999" />

                <EditText
                    android:id="@+id/et_search"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="Cari artikel kesehatan..."
                    android:textColorHint="#999999"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#333333"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- CONTENT AREA (White with rounded top) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_content_round_top"
        android:backgroundTint="@color/home_bg"
        android:orientation="vertical"
        android:paddingTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/layout_top"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- CHIPS AREA -->
        <HorizontalScrollView
            android:id="@+id/scroll_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp">

                <!-- Semua -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_semua"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="20dp"
                    android:fontFamily="@font/poppins_bold"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Semua"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:letterSpacing="0"
                    app:backgroundTint="#0B7955"
                    app:cornerRadius="18dp"
                    app:strokeWidth="0dp" />

                <!-- Tersimpan -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_tersimpan"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="20dp"
                    android:fontFamily="@font/poppins_regular"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Tersimpan"
                    android:textAllCaps="false"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:letterSpacing="0"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="18dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0"/>

                <!-- Nutrisi -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_nutrisi"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="20dp"
                    android:fontFamily="@font/poppins_regular"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Nutrisi"
                    android:textAllCaps="false"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:letterSpacing="0"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="18dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0"/>

                <!-- Olahraga -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_olahraga"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="20dp"
                    android:fontFamily="@font/poppins_regular"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Olahraga"
                    android:textAllCaps="false"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:letterSpacing="0"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="18dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0"/>

                <!-- Kesehatan -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_kesehatan"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="20dp"
                    android:fontFamily="@font/poppins_regular"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Kesehatan"
                    android:textAllCaps="false"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:letterSpacing="0"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="18dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0"/>

                <!-- Diet -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_diet"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="20dp"
                    android:fontFamily="@font/poppins_regular"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Diet"
                    android:textAllCaps="false"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:letterSpacing="0"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="18dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0"/>

                <!-- Lainnya -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chip_gaya_hidup"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingHorizontal="20dp"
                    android:fontFamily="@font/poppins_regular"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Lainnya"
                    android:textAllCaps="false"
                    android:textColor="#555555"
                    android:textSize="13sp"
                    android:letterSpacing="0"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="18dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#E0E0E0"/>
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/layout_title"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:visibility="gone"/>

        <!-- CONTENT AREA (RecyclerView) -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_articles"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingHorizontal="16dp"
                android:paddingBottom="32dp"
                tools:listitem="@layout/item_article" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- LOADING SHIMMER -->
        <LinearLayout
            android:id="@+id/layout_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_image_shimmer" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_image_shimmer" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_image_shimmer" />
        </LinearLayout>

        <!-- EMPTY / ERROR STATE -->
        <LinearLayout
            android:id="@+id/layout_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginBottom="16dp"
                android:src="@drawable/img_empty_food"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/tv_error_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:textColor="#6B9B8E"
                android:textSize="13sp"
                tools:text="@string/error_no_articles" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppins_bold"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/btn_try_again"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:backgroundTint="#0B7955"
                app:cornerRadius="20dp"
                app:strokeWidth="0dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>