<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    android:background="@drawable/bg_splash_gradient">

    <LinearLayout
        android:id="@+id/layoutLocationInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:alpha="0"
        tools:alpha="1"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="34dp"
                android:layout_height="26dp"
                app:cardCornerRadius="4dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/transparent"
                android:layout_marginEnd="10dp">
                <ImageView
                    android:id="@+id/imgFlag"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/flag_id"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/txtCountry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Indonesia"
                android:fontFamily="serif"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:includeFontPadding="false"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtCity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:includeFontPadding="false"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Bekasi"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.46">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="180dp"
            android:layout_height="170dp"
            android:src="@drawable/fitme_logo"
            android:scaleType="fitCenter"
            android:alpha="0"
            tools:alpha="1"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:id="@+id/layoutTitleFinal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="invisible"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/layoutFitmeLetters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView android:id="@+id/txtLetterF"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="F" android:fontFamily="serif" android:textStyle="bold"
                    android:textColor="@color/white" android:textSize="46sp"
                    android:includeFontPadding="false"/>
                <TextView android:id="@+id/txtLetterI"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="I" android:fontFamily="serif" android:textStyle="bold"
                    android:textColor="@color/white" android:textSize="46sp"
                    android:includeFontPadding="false"/>
                <TextView android:id="@+id/txtLetterT"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="T" android:fontFamily="serif" android:textStyle="bold"
                    android:textColor="@color/white" android:textSize="46sp"
                    android:includeFontPadding="false"/>
                <TextView android:id="@+id/txtLetterM"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="M" android:fontFamily="serif" android:textStyle="bold"
                    android:textColor="@color/white" android:textSize="46sp"
                    android:includeFontPadding="false"/>
                <TextView android:id="@+id/txtLetterE"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="E" android:fontFamily="serif" android:textStyle="bold"
                    android:textColor="@color/white" android:textSize="46sp"
                    android:includeFontPadding="false"/>
            </LinearLayout>

            <TextView
                android:id="@+id/txtTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sahabat Hidup Sehat"
                android:fontFamily="serif"
                android:textColor="#CCF0F0"
                android:textSize="14sp"
                android:letterSpacing="0.08"
                android:includeFontPadding="false"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:alpha="0"
        tools:alpha="1"
        android:layout_marginBottom="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:indeterminateTint="#A7F3D0"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>